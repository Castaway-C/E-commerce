# Backend
APP_NAME=its-mygo
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=mysql+asyncmy://root:your-password@127.0.0.1:3306/its_mygo?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET_KEY=replace-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):\d+$
ORDER_PAYMENT_EXPIRE_MINUTES=15
ORDER_AUTO_CONFIRM_DAYS=7
CELERY_CANCEL_UNPAID_INTERVAL_SECONDS=300
CELERY_EXPIRE_COUPON_INTERVAL_SECONDS=300
CELERY_AUTO_CONFIRM_INTERVAL_SECONDS=3600

# Local data seeding only. When true, clicking "I have paid / sync result"
# marks the payment as paid without querying Alipay. Keep false for normal testing.
PAYMENT_MOCK_ENABLED=false

# Alipay sandbox scan-code payment. Keep keys only in local .env, never commit real values.
ALIPAY_ENABLED=true
# Current sandbox gateway used by this project.
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=your-sandbox-app-id
ALIPAY_APP_PRIVATE_KEY=your-python-sdk-pkcs1-app-private-key
ALIPAY_PUBLIC_KEY=your-alipay-public-key
ALIPAY_NOTIFY_URL=http://localhost:8000/api/v1/payments/notify/alipay
ALIPAY_SUBJECT_PREFIX=its-mygo-order

# AI assistant. qwen-flash uses DashScope/OpenAI-compatible API.
# Keep API keys only in local .env, never commit real values.
AI_ASSISTANT_ENABLED=true
AI_ASSISTANT_PROVIDER=qwen
AI_ASSISTANT_MODEL=qwen-flash
AI_ASSISTANT_BASE_URL=https://ws-hnuof8rzherwpnjw.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your-dashscope-api-key
# Optional alias. If set, this takes precedence over DASHSCOPE_API_KEY.
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_REQUEST_TIMEOUT_SECONDS=30
AI_ASSISTANT_ENABLE_THINKING=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
